{
  "containers": [
    {
      "name": "cpa",
      "image": "eceasy/cli-proxy-api:latest",
      "entrypoint": ["/CLIProxyAPI/CLIProxyAPI"],
      "cmd": ["-config", "/home/cpa/config.yaml"]
    },
    {
      "name": "cpamp",
      "image": "seakee/cpa-manager-plus:latest",
      "entrypoint": ["/bin/sh", "-c"],
      "cmd": ["export USAGE_DATA_DIR=/home/cpamp/data USAGE_DB_PATH=/home/cpamp/data/usage.sqlite CPA_MANAGER_DATA_KEY_PATH=/home/cpamp/data/data.key CPA_UPSTREAM_URL=http://127.0.0.1:8317; exec /usr/local/bin/cpa-manager-plus"],
      "env": {
        "CPA_MANAGER_DATA_KEY_PATH": "/home/cpamp/data/data.key",
        "CPA_UPSTREAM_URL": "http://127.0.0.1:8317",
        "GODEBUG": "http2client=0",
        "USAGE_DATA_DIR": "/home/cpamp/data",
        "USAGE_DB_PATH": "/home/cpamp/data/usage.sqlite"
      },
      "secrets": [
        {"env_var": "CPA_MANAGEMENT_KEY", "name": "CPA_MANAGEMENT_KEY"},
        {"env_var": "CPA_MANAGER_ADMIN_KEY", "name": "CPA_MANAGER_ADMIN_KEY"}
      ]
    }
  ]
}
